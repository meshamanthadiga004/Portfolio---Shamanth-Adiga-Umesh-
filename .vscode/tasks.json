{
  "version": "2.0.0",
  // These call dev.cmd / deploy.cmd rather than "npm run ...".
  //
  // npm rebuilds PATH internally and re-invokes cmd, which splits the path at
  // the "&" in "Claude & Cowork" — so every npm script fails in this folder.
  // The .cmd wrappers call node directly with a quoted path, which is safe.
  "options": {
    "shell": {
      "executable": "cmd.exe",
      "args": ["/d", "/c"]
    }
  },
  "tasks": [
    {
      "label": "Deploy site",
      "type": "shell",
      "command": "deploy.cmd",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Preview site (localhost)",
      "type": "shell",
      "command": "dev.cmd",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
